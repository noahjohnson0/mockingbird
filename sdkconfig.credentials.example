# Copy this file to `sdkconfig.credentials` and fill in real values.
# `sdkconfig.credentials` is gitignored so secrets never end up in git.
#
# `idf.py` automatically loads `sdkconfig.defaults` *and* `sdkconfig.credentials`
# when generating sdkconfig, so anything here overrides the defaults.

# WiFi (consumed by MicroLink's Kconfig and by main.c via CONFIG_ML_WIFI_*)
CONFIG_ML_WIFI_SSID="my-wifi-ssid"
CONFIG_ML_WIFI_PASSWORD="my-wifi-password"

# Tailscale auth key — generate at https://login.tailscale.com/admin/settings/keys
# Recommended: reusable + ephemeral + pre-approved + tagged (e.g. tag:esp32).
CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-..."

# Device hostname on the tailnet. Leave empty to auto-derive from MAC.
CONFIG_ML_DEVICE_NAME="esp32-fw"

# Shared secret required by the OTA HTTP endpoint (X-OTA-Token header).
# Pick a long random string — `openssl rand -hex 32` is fine.
CONFIG_FW_OTA_TOKEN="change-me-please"
